# Copy this file to backend/.env and fill in your MoyKlass API key.
MOYKLASS_API_KEY=your-api-key-here
MOYKLASS_AUTH_URL=https://api.moyklass.com/v1/company/auth/getToken
MOYKLASS_USERS_URL=https://api.moyklass.com/v1/company/users
MOYKLASS_MANAGERS_URL=https://api.moyklass.com/v1/company/managers

# Dashboard login (single analyst account).
DASHBOARD_USERNAME=analyst
# Generate with: python scripts/hash_password.py
DASHBOARD_PASSWORD_HASH=
# Development fallback only; prefer DASHBOARD_PASSWORD_HASH.
# DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_SECONDS=43200

# Storage and refresh.
# DATABASE_PATH defaults to backend/data/dashboard.db
REFRESH_INTERVAL_SECONDS=3600
DATA_TTL_SECONDS=3600

# Browser origins allowed to call the API. In production set only your domain:
# CORS_ORIGINS=https://dashboard.example.com
# Same-origin requests through nginx do not need CORS.
CORS_ORIGINS=http://localhost:8080,http://localhost:8000,null

# Project participants are users tagged with this prefix in the CRM.
PROJECT_TAG_PREFIX=ФПГ_ЦН
# Optional exact list instead of the prefix (comma-separated):
# PROJECT_TAG_NAMES=ФПГ_ЦН Консультации,ФПГ_ЦН Мастер-класс по ИИ
PROJECT_START_DATE=2025-02-01
